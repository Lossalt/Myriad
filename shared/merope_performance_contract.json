{
  "schemaVersion": 1,
  "phraseIntents": ["ask", "hesitate", "tease", "explain", "check-in", "laugh", "none"],
  "baselineExpressions": ["withdrawn", "subdued", "steady", "warm", "tense"],
  "postures": ["closed", "neutral", "open"],
  "bodyPoseTiming": {"transitionMs": 300, "holdMs": 5000, "minTransitionMs": 80, "maxTransitionMs": 2000, "maxHoldMs": 15000},
  "extentTiers": {"slight": 0.35, "clear": 0.65, "strong": 1},
  "levels": {
    "motionEnergy": {"low": 0.7, "usual": 1, "high": 1.3},
