    "cueIntensity": {"slight": 0.75, "clear": 1, "strong": 1.3},
    "tempo": {"slow": 0.75, "usual": 1, "quick": 1.3}
  },
  "bodyControls": {
    "headTurn": {"min": -1, "max": 1, "capability": "head-body", "description": "Turn head: negative image-left, positive image-right."},
    "headNod": {"min": -1, "max": 1, "capability": "head-body", "description": "Head pitch: negative down, positive up."},
    "headTilt": {"min": -1, "max": 1, "capability": "head-body", "description": "Head side tilt, negative counterclockwise, positive clockwise, as it shows: slight about 8 degrees (a tilt one notices), clear about 15 degrees (puzzlement, curiosity), strong about 24 degrees (the fullest)."},
    "torsoTurn": {"min": -1, "max": 1, "capability": "torso-volume", "description": "Turn torso independently of head: negative image-left, positive image-right."},
    "torsoLean": {"min": -1, "max": 1, "capability": "head-body", "description": "Upper-body side lean: negative counterclockwise, positive clockwise."},
    "torsoRise": {"min": -1, "max": 1, "capability": "head-body", "description": "Upper body: negative settle, positive rise, independent of head pitch."},
    "torsoPitch": {"min": -1, "max": 1, "capability": "torso-volume", "description": "Upper body: negative lean back, positive lean forward, independent of head."},
    "gazeHorizontal": {"min": -1, "max": 1, "capability": "independent-eyes", "description": "Look image-left (-) or image-right (+), independently of head."},
    "gazeVertical": {"min": -1, "max": 1, "capability": "independent-eyes", "description": "Look down (-) or up (+)."},
    "leftArmRaise": {"min": -1, "max": 1, "capability": "left-arm", "description": "Image-left arm: positive opens away from body, negative tucks in."},
    "rightArmRaise": {"min": -1, "max": 1, "capability": "right-arm", "description": "Image-right arm: positive opens away from body, negative tucks in."},
    "leftArmSwing": {"min": -1, "max": 1, "capability": "left-arm", "description": "Swing image-left arm toward image-left (-) or right (+)."},
    "rightArmSwing": {"min": -1, "max": 1, "capability": "right-arm", "description": "Swing image-right arm toward image-left (-) or right (+)."},
    "eyeOpenLeft": {"min": 0, "max": 1, "rest": 1, "capability": "independent-eyes", "description": "Image-left eye closing from open: strong shuts it; use alone for a wink."},
    "eyeOpenRight": {"min": 0, "max": 1, "rest": 1, "capability": "independent-eyes", "description": "Image-right eye closing from open: strong shuts it."},
    "eyeSmile": {"min": 0, "max": 1, "capability": "independent-eyes", "description": "Smile reaching the lower eyelids."},
    "eyeWide": {"min": 0, "max": 1, "capability": "independent-eyes", "description": "Widen eyes in surprise or interest."},
    "browLift": {"min": -1, "max": 1, "capability": "head-body", "description": "Lower (-) or raise (+) brows."},
    "browTiltLeft": {"min": -1, "max": 1, "capability": "head-body", "description": "Image-left eyebrow slant, independently of the other brow."},
    "browTiltRight": {"min": -1, "max": 1, "capability": "head-body", "description": "Image-right eyebrow slant, independently of the other brow."},
    "mouthSmile": {"min": -1, "max": 1, "capability": "mouth-shapes", "description": "Frown (-) or smile (+); can colour ongoing speech."},
    "mouthOpen": {"min": 0, "max": 1, "capability": "mouth-shapes", "description": "Open mouth while not vocalizing; speech retains articulation ownership."},
    "mouthWide": {"min": 0, "max": 1, "capability": "mouth-shapes", "description": "Wide resting mouth shape; only while not vocalizing."},
    "mouthRound": {"min": 0, "max": 1, "capability": "mouth-shapes", "description": "Rounded resting mouth shape; only while not vocalizing."},
    "mouthNarrow": {"min": 0, "max": 1, "capability": "mouth-shapes", "description": "Narrow resting mouth shape; only while not vocalizing."},
    "mouthSeal": {"min": 0, "max": 1, "capability": "mouth-shapes", "description": "Sealed lips; only while not vocalizing."},
    "angry": {"min": 0, "max": 1, "tiers": {"slight": 0.6, "clear": 0.8, "strong": 1}, "capability": "head-body", "description": "Sustained angry expression, not an automatic response to disagreement."},
    "speechless": {"min": 0, "max": 1, "capability": "head-body", "description": "Sustained unimpressed/speechless expression."},
    "maniac": {"min": 0, "max": 1, "capability": "maniac-mouth", "description": "Full laughing expression; unavailable while speaking or singing."},
    "silly": {"min": 0, "max": 1, "tiers": {"strong": 1}, "capability": "silly-eye", "description": "Sustained playful/self-deprecating expression."},
    "lovestruck": {"min": 0, "max": 1, "tiers": {"strong": 1}, "capability": "lovestruck", "description": "Sustained affectionate expression."},
    "cry": {"min": 0, "max": 1, "tiers": {"slight": 0.2, "clear": 0.35, "strong": 1}, "capability": "cry-eye", "description": "Tears: slight wet eyes, clear tears running, strong sobbing with eyes squeezed shut; speech keeps the mouth."},
    "dizzy": {"min": 0, "max": 1, "tiers": {"strong": 1}, "capability": "dizzy-eye", "description": "Sustained dizzy-eye expression."},
    "hairSway": {"min": 0, "max": 1, "capability": "head-body", "description": "Secondary hair response from still (0) to energetic (1); never move hair off its attachment."},
    "chestSway": {"min": 0, "max": 1, "capability": "head-body", "description": "Secondary chest response from still (0) to energetic (1); local asset physics remain bounded."},
    "musicNotes": {"min": 0, "max": 1, "tiers": {"strong": 1}, "capability": "music-notes", "description": "Music notes drawn beside her head: humming, enjoying a song."},
    "questionMark": {"min": 0, "max": 1, "tiers": {"strong": 1}, "capability": "question-mark", "description": "A question mark drawn beside her head: puzzled, wondering."},
    "sleepZ": {"min": 0, "max": 1, "tiers": {"strong": 1}, "capability": "sleep-z", "description": "A drawn \"Z z z\" beside her head: sleepy, dozing."},
    "sparkles": {"min": 0, "max": 1, "tiers": {"strong": 1}, "capability": "sparkles", "description": "Sparkles drawn beside her head: excited, delighted, a bright idea."},
    "blush": {"min": 0, "max": 1, "capability": "blush", "description": "Drawn blush across her cheeks: shy, flustered, touched."}
  },
  "facePresets": {
    "content": {"description": "eyes closed in a smile (^ ^), content and happy", "targets": {"eyeOpenLeft": "-strong", "eyeOpenRight": "-strong", "eyeSmile": "strong", "mouthSmile": "clear", "browLift": "slight"}, "life": {"periodMs": 6000, "beats": [{"atMs": 0, "pose": {"targets": {"headTilt": "slight"}, "transitionMs": 1400, "holdMs": 1300}}, {"atMs": 3000, "pose": {"targets": {"headTilt": "-slight"}, "transitionMs": 1400, "holdMs": 1300}}]}},
    "tender": {"description": "soft smiling eyes, gentle smile, head tilted: tender", "targets": {"eyeSmile": "clear", "mouthSmile": "clear", "headTilt": "slight", "eyeOpenLeft": "-slight", "eyeOpenRight": "-slight"}, "life": {"periodMs": 7000, "beats": [{"atMs": 2000, "move": {"kind": "nod", "amount": "slight", "tempo": "slow"}}, {"atMs": 5200, "move": {"kind": "blink", "amount": "slight", "tempo": "slow"}}]}},
    "smug": {"description": "half-lidded eyes, smile, chin up: pleased with herself", "targets": {"eyeOpenLeft": "-slight", "eyeOpenRight": "-slight", "mouthSmile": "clear", "headNod": "slight", "headTilt": "-slight", "browLift": "slight"}, "life": {"periodMs": 6500, "beats": [{"atMs": 1500, "move": {"kind": "nod", "amount": "slight", "tempo": "quick"}}, {"atMs": 4200, "move": {"kind": "glance", "amount": "slight", "tempo": "usual", "direction": "left"}}]}},
    "teasing": {"description": "one eye narrowed, sly smile: teasing", "targets": {"eyeOpenLeft": "-clear", "mouthSmile": "clear", "headTilt": "slight", "gazeHorizontal": "slight", "browLift": "slight"}, "life": {"periodMs": 5000, "beats": [{"atMs": 1200, "move": {"kind": "bounce", "amount": "slight", "tempo": "quick"}}, {"atMs": 3200, "move": {"kind": "glance", "amount": "clear", "tempo": "quick", "direction": "right"}}]}},
    "shy": {"description": "eyes down and away, head lowered, small smile: shy", "targets": {"gazeVertical": "-clear", "gazeHorizontal": "clear", "headNod": "-slight", "headTurn": "slight", "mouthSmile": "slight", "eyeOpenLeft": "-slight", "eyeOpenRight": "-slight"}, "life": {"periodMs": 6000, "beats": [{"atMs": 1800, "move": {"kind": "glance", "amount": "clear", "tempo": "quick", "direction": "up-left"}}, {"atMs": 4300, "move": {"kind": "blink", "amount": "slight", "tempo": "slow"}}]}},
    "surprised": {"description": "eyes wide, mouth open: caught by surprise", "targets": {"eyeWide": "strong", "browLift": "strong", "mouthOpen": "clear", "headNod": "slight", "torsoRise": "slight"}, "life": {"periodMs": 6000, "beats": [{"atMs": 1200, "move": {"kind": "blink", "amount": "clear", "tempo": "quick", "count": 2}}]}},
    "dreamy": {"description": "eyes raised and soft, head up: lost in a daydream", "targets": {"gazeVertical": "clear", "gazeHorizontal": "slight", "eyeOpenLeft": "-slight", "eyeOpenRight": "-slight", "mouthSmile": "slight", "headTilt": "slight", "headNod": "slight"}, "life": {"periodMs": 9000, "beats": [{"atMs": 0, "pose": {"targets": {"gazeHorizontal": "-slight"}, "transitionMs": 2600, "holdMs": 1600}}, {"atMs": 3600, "move": {"kind": "blink", "amount": "slight", "tempo": "slow"}}, {"atMs": 4500, "pose": {"targets": {"gazeHorizontal": "clear"}, "transitionMs": 2600, "holdMs": 1600}}]}},
    "downcast": {"description": "eyes lowered under half-closed lids, on something in front of her", "targets": {"eyeOpenLeft": "-clear", "eyeOpenRight": "-clear", "gazeVertical": "-clear", "headNod": "-slight", "browLift": "-slight"}, "life": {"periodMs": 7000, "beats": [{"atMs": 2500, "move": {"kind": "sigh", "amount": "slight", "tempo": "slow"}}, {"atMs": 5600, "move": {"kind": "blink", "amount": "slight", "tempo": "slow"}}]}},
    "focused": {"description": "eyes narrowed, leaning in: concentrating", "targets": {"browLift": "-clear", "eyeOpenLeft": "-slight", "eyeOpenRight": "-slight", "torsoPitch": "clear", "headNod": "-slight", "mouthSmile": "-slight"}, "life": {"periodMs": 5000, "beats": [{"atMs": 800, "move": {"kind": "glance", "amount": "slight", "tempo": "usual", "direction": "right"}}, {"atMs": 3000, "move": {"kind": "nod", "amount": "slight", "tempo": "usual"}}]}},
    "drowsy": {"description": "lids heavy, head drooping: sleepy", "targets": {"eyeOpenLeft": "-clear", "eyeOpenRight": "-clear", "headNod": "-clear", "headTilt": "slight", "browLift": "-slight"}, "life": {"periodMs": 8000, "beats": [{"atMs": 1200, "pose": {"targets": {"eyeOpenLeft": "-strong", "eyeOpenRight": "-strong", "headNod": "-strong"}, "transitionMs": 2600, "holdMs": 900}}, {"atMs": 5000, "move": {"kind": "startle", "amount": "slight", "tempo": "usual"}}, {"atMs": 6600, "move": {"kind": "blink", "amount": "clear", "tempo": "slow"}}]}},
    "worried": {"description": "eyes down and aside, mouth turned down: worried, troubled", "targets": {"browLift": "clear", "browTiltLeft": "clear", "browTiltRight": "-clear", "gazeVertical": "-slight", "gazeHorizontal": "-slight", "mouthSmile": "-clear", "headTilt": "-slight", "headNod": "-slight", "eyeOpenLeft": "-slight", "eyeOpenRight": "-slight"}, "life": {"periodMs": 6500, "beats": [{"atMs": 1200, "move": {"kind": "glance", "amount": "clear", "tempo": "quick", "direction": "left"}}, {"atMs": 3000, "move": {"kind": "glance", "amount": "slight", "tempo": "quick", "direction": "right"}}, {"atMs": 4800, "move": {"kind": "sigh", "amount": "slight", "tempo": "slow"}}]}},
    "pout": {"description": "head turned away, side-eye, mouth pulled down: pouting", "targets": {"mouthSmile": "-clear", "mouthRound": "slight", "browLift": "-slight", "headTurn": "clear", "gazeHorizontal": "-clear", "headNod": "-slight"}, "life": {"periodMs": 6000, "beats": [{"atMs": 1800, "move": {"kind": "glance", "amount": "clear", "tempo": "quick", "direction": "right"}}, {"atMs": 3600, "move": {"kind": "shake", "amount": "slight", "tempo": "quick"}}]}},
    "humming": {"description": "eyes closed in a smile, music notes beside her: humming along, enjoying a song", "targets": {"eyeOpenLeft": "-strong", "eyeOpenRight": "-strong", "eyeSmile": "strong", "mouthSmile": "clear", "browLift": "slight", "musicNotes": "strong"}, "life": {"periodMs": 2400, "beats": [{"atMs": 0, "pose": {"targets": {"headTilt": "slight"}, "transitionMs": 1000, "holdMs": 150}}, {"atMs": 1200, "pose": {"targets": {"headTilt": "-slight"}, "transitionMs": 1000, "holdMs": 150}}]}},
    "puzzled": {"description": "head tilted, eyes up and aside, a question mark beside her: puzzled, wondering", "targets": {"headTilt": "clear", "gazeVertical": "slight", "gazeHorizontal": "slight", "mouthSmile": "-slight", "questionMark": "strong"}, "life": {"periodMs": 6000, "beats": [{"atMs": 1500, "pose": {"targets": {"headTilt": "strong"}, "transitionMs": 800, "holdMs": 1200}}, {"atMs": 4200, "move": {"kind": "blink", "amount": "slight", "tempo": "quick", "count": 2}}]}},
    "sleepy": {"description": "lids heavy, head drooping, \"Z z z\" beside her: sleepy, dozing off", "targets": {"eyeOpenLeft": "-clear", "eyeOpenRight": "-clear", "headNod": "-clear", "headTilt": "slight", "browLift": "-slight", "sleepZ": "strong"}, "life": {"periodMs": 8000, "beats": [{"atMs": 800, "pose": {"targets": {"eyeOpenLeft": "-strong", "eyeOpenRight": "-strong", "headNod": "-strong"}, "transitionMs": 2600, "holdMs": 900}}, {"atMs": 4800, "move": {"kind": "startle", "amount": "slight", "tempo": "usual"}}, {"atMs": 6400, "move": {"kind": "blink", "amount": "clear", "tempo": "slow"}}]}},
    "excited": {"description": "eyes wide and bright, big smile, sparkles beside her: excited, delighted", "targets": {"eyeWide": "clear", "eyeSmile": "slight", "mouthSmile": "clear", "torsoRise": "slight", "sparkles": "strong"}, "life": {"periodMs": 3000, "beats": [{"atMs": 300, "move": {"kind": "bounce", "amount": "strong", "tempo": "quick", "count": 2}}]}},
    "blushing": {"description": "eyes down and away, small smile, cheeks blushing: shy, flustered", "targets": {"gazeVertical": "-clear", "gazeHorizontal": "clear", "headNod": "-slight", "headTurn": "slight", "mouthSmile": "slight", "eyeOpenLeft": "-slight", "eyeOpenRight": "-slight", "blush": "clear"}, "life": {"periodMs": 6000, "beats": [{"atMs": 2200, "move": {"kind": "glance", "amount": "clear", "tempo": "quick", "direction": "up-left"}}, {"atMs": 4400, "move": {"kind": "blink", "amount": "slight", "tempo": "slow"}}]}}
  },
